# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from GitHub Secrets and
# never touches the repo; see .github/workflows/deploy.yml.
#
# The Headscale API key and the Headplane cookie secret are NOT here: the
# coordination_stack role generates both on the box itself on first run and
# persists them under {{ stack_dir }}/headplane, root-only, outside git
# entirely.

# One Google OAuth client, shared by two separate login flows:
#   - headscale's own OIDC (a `tailscale up` client joining the tailnet)
#   - Headplane's OIDC (you logging into the admin UI)
# Register both redirect URIs on it: https://<domain>/oidc/callback and
# https://<domain>/admin/oidc/callback. See SETUP.md.
oidc_client_id: "CHANGEME.apps.googleusercontent.com"
oidc_client_secret: "CHANGEME"

# REQUIRED — without this, any Google account can authenticate a tailscale
# client against your headscale server. List every email allowed to join.
oidc_allowed_users:
  - "you@example.com"
