# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from GitHub Secrets and
# never touches the repo; see .github/workflows/deploy.yml.
#
# The Headscale API key and the Headplane cookie secret are NOT here: the
# coordination_stack role generates both on the box itself on first run and
# persists them under {{ stack_dir }}/headplane, root-only, outside git
# entirely.
headplane_oidc_client_id: "CHANGEME.apps.googleusercontent.com"
headplane_oidc_client_secret: "CHANGEME"
