# Real inventory (inventory/hosts.ini) is git-ignored and, in CI, generated
# at deploy time from OpenTofu outputs — see .github/workflows/deploy.yml.
#
# For a manual/local run: first open ONE persistent IAP tunnel in another
# terminal (leave it running for the whole session):
#
#   gcloud compute start-iap-tunnel coordination-server 22 \
#     --local-host-port=localhost:2222 \
#     --project=YOUR_PROJECT_ID --zone=YOUR_ZONE
#
# Then copy this file to inventory/hosts.ini and use it as-is — Ansible
# connects to that local forwarded port, not to the VM's real IP, so SSH
# never touches the public internet.
#
# (A per-connection stdin ProxyCommand instead of a persistent tunnel was
# tried first and made things dramatically slower — see the deploy.yml
# comment for why. One tunnel for the whole run is the pattern that works.)

[coordination_server]
coordination-server ansible_host=127.0.0.1 ansible_port=2222 ansible_user=deploy

[coordination_server:vars]
ansible_ssh_private_key_file=~/.ssh/deploy_key
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new -o ControlMaster=auto -o ControlPersist=15m -o ControlPath=/tmp/ansible-cp/%C
# mkdir -p /tmp/ansible-cp before running the playbook.
